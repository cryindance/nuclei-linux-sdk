/dts-v1/;

#ifndef SIMULATION
#define SIMULATION          0
#endif

#if SIMULATION == 2
#undef TIMERCLK_FREQ
#define TIMERCLK_FREQ       500000
#else
#ifndef TIMERCLK_FREQ
#define TIMERCLK_FREQ       32768
#endif
#endif

#ifndef CPUCLK_FREQ
#define CPUCLK_FREQ         100000000
#endif
#ifndef PERIPHCLK_FREQ
#define PERIPHCLK_FREQ      32000016
#endif

/ {
  #address-cells = <2>;
  #size-cells = <2>;
  compatible = "nuclei,evalsoc";
  model = "nuclei,evalsoc";
  dma-noncoherent;
  chosen {
#if SIMULATION == 2
      bootargs = "earlycon=sbi console=hvc0";
#else
      bootargs = "earlycon=sbi console=ttyNUC0";
#endif
      stdout-path = "serial0";
  };

  aliases {
    serial0 = &uart0;
    serial1 = &uart1;
  };

  cpus {
    #address-cells = <1>;
    #size-cells = <0>;
    timebase-frequency = <TIMERCLK_FREQ>;
    cpu0: cpu@0 {
      device_type = "cpu";
      reg = <0>;
      status = "okay";
      compatible = "riscv";
      riscv,isa = "rv64imafdc_zicbom_svpbmt";
      riscv,cbom-block-size =<64>;
      mmu-type = "riscv,sv39";
      clock-frequency = <CPUCLK_FREQ>;
      cpu0_intc: interrupt-controller {
        #interrupt-cells = <1>;
        interrupt-controller;
        compatible = "riscv,cpu-intc";
      };
    };
    cpu1: cpu@1 {
      device_type = "cpu";
      reg = <1>;
      status = "okay";
      compatible = "riscv";
      riscv,isa = "rv64imafdc_zicbom_svpbmt";
      riscv,cbom-block-size =<64>;
      mmu-type = "riscv,sv39";
      clock-frequency = <CPUCLK_FREQ>;
      cpu1_intc: interrupt-controller {
        #interrupt-cells = <1>;
        interrupt-controller;
        compatible = "riscv,cpu-intc";
      };
    };
    
  };

  memory@c1000000 {
    device_type = "memory";
    reg = <0x0 0xc1000000 0x0 0x3D000000>;
  };

  soc {
    #address-cells = <2>;
    #size-cells = <2>;
    compatible = "nuclei,evalsoc", "simple-bus";
    ranges;
  };

  /* Used for Uboot SBI Console */
  console {
    compatible = "sbi,console";
  };

  hfclk: hfclk {
    #clock-cells = <0>;
    compatible = "fixed-clock";
    clock-frequency = <PERIPHCLK_FREQ>;
    clock-output-names = "hfclk";
  };

  plic0: interrupt-controller@1c000000 {
    #interrupt-cells = <1>;
    compatible = "riscv,plic0";
    interrupt-controller;
    riscv,ndev = <64>;
    interrupts-extended =
          <&cpu0_intc 11 &cpu0_intc 9
           &cpu1_intc 11 &cpu1_intc 9 >;
    reg = <0x0 0x1c000000 0x0 0x4000000>;
  };

  clint0: clint@18031000 {
    #interrupt-cells = <1>;
    compatible = "riscv,clint0";
    reg = <0x0 0x18031000 0x0 0xC000>;
    interrupts-extended =
          <&cpu0_intc 3 &cpu0_intc 7
           &cpu1_intc 3 &cpu1_intc 7 >;
    clocks = <&hfclk>;
  };

  uart0: serial@4001000 {
    compatible = "nuclei,uart0";
    reg = <0x0 0x4001000 0x0 0x1000>;
    interrupt-parent = <&plic0>;
    interrupts = <3>;
    clocks = <&hfclk>;
    clock-frequency = <PERIPHCLK_FREQ>;
    status = "okay";
  };

  uart1: serial@96000000 {
    compatible = "nuclei,uart0";
    reg = <0x0 0x96000000 0x0 0x1000>;
    interrupt-parent = <&plic0>;
    interrupts = <34>;
    clocks = <&hfclk>;
    clock-frequency = <PERIPHCLK_FREQ>;
    status = "disabled";
  };

#if SIMULATION == 0
  qspi0: spi@14101000 {
    compatible = "nuclei,spi0";
    reg = <0x0 0x14101000 0x0 0x1000>;
    interrupt-parent = <&plic0>;
    interrupts = <6>;
    num-cs = <1>;
    #address-cells = <1>;
    #size-cells = <0>;
    clocks = <&hfclk>;
    status = "okay";

    flash@0 {
      compatible = "jedec,spi-nor";
      reg = <0>;
      spi-max-frequency = <1000000>;
      m25p,fast-read;
      spi-tx-bus-width = <1>;
      spi-rx-bus-width = <1>;
    };
  };

  qspi2: spi@14102000 {
    compatible = "nuclei,spi0";
    reg = <0x0 0x14102000 0x0 0x1000>;
    interrupt-parent = <&plic0>;
    interrupts = <7>;
    num-cs = <1>;
    #address-cells = <1>;
    #size-cells = <0>;
    clocks = <&hfclk>;
    status = "okay";

    mmc@0 {
      compatible = "mmc-spi-slot";
      reg = <0>;
      spi-max-frequency = <20000000>;
      voltage-ranges = <3300 3300>;
      disable-wp;
      spi-tx-bus-width = <1>;
      spi-rx-bus-width = <1>;
    };
  };
#endif
  mailbox: mailbox@8800000 {
    compatible = "nuclei,nuclei-mbox";
    reg = <0x0 0x8800000 0x0 0x3000>;
    interrupt-parent = <&plic0>;
    interrupts = <17>;
    #mbox-cells = <1>;
    status = "okay";
  };

  crypto {
    compatible = "nuclei,nuclei-crypto";
    mboxes = <&mailbox 0>;
    status = "okay";
  };

  firmware {
    optee {
      compatible = "linaro,optee-tz";
      method = "smc";
    };
  };

};
